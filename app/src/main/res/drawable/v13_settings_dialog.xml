<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/v13_settings_cyan"
                android:centerColor="@color/v13_settings_purple"
                android:endColor="@color/v13_settings_pink" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/v13_settings_background" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
