<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Two-step lightweight neon halo; no blur bitmap, animation or GPU filter. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#5540E5FF"
                android:centerColor="#554C6BFF" android:endColor="#66F932EF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/v10_neon_cyan"
                android:centerColor="@color/v10_neon_blue" android:endColor="@color/v10_neon_pink"/>
            <corners android:radius="17dp"/>
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#111D31"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
