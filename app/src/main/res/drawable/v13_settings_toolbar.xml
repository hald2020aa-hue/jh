<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/v13_settings_background" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0"
                android:startColor="@color/v13_settings_cyan"
                android:centerColor="@color/v13_settings_purple"
                android:endColor="@color/v13_settings_pink" />
        </shape>
    </item>
</layer-list>
