<?xml version='1.0' encoding='UTF-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView android:id="@+id/end_view" style="@style/Widget.Tachiyomi.CardView.Container" android:layout_height="match_parent" android:visibility="gone" app:cardBackgroundColor="@color/material_red_500">

        <com.google.android.material.textview.MaterialTextView android:id="@+id/close_right" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="end|center" android:layout_marginEnd="21dp" android:contentDescription="@string/cancel" android:gravity="center" android:src="@drawable/ic_close_24dp" android:text="@string/hide" android:textColor="@color/md_white_1000"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:id="@+id/start_view" style="@style/Widget.Tachiyomi.CardView.Container" android:layout_height="match_parent" android:visibility="gone" app:cardBackgroundColor="@color/material_red_500">

        <com.google.android.material.textview.MaterialTextView android:id="@+id/close_left" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="start|center" android:layout_marginStart="21dp" android:gravity="center" android:src="@drawable/ic_close_24dp" android:text="@string/hide" android:textColor="@color/md_white_1000"/>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/source_card" style="@style/Widget.Tachiyomi.CardView.Container" app:cardCornerRadius="14dp" app:cardElevation="0dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" app:strokeWidth="1dp" app:strokeColor="@color/v4_outline" app:cardBackgroundColor="@color/v4_card">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="68dp" android:background="@drawable/v4_neon_surface">

        <ImageView android:id="@+id/source_image" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="9dp" android:padding="6dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintDimensionRatio="1:1" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" tools:src="@mipmap/ic_launcher_round"/>

        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:paddingStart="0dp" android:paddingEnd="8dp" android:textColor="@color/v4_text" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@+id/source_latest" app:layout_constraintStart_toEndOf="@+id/source_image" app:layout_constraintTop_toTopOf="parent" tools:text="Source title" android:textSize="14sp" android:textStyle="bold"/>

        <View android:id="@+id/source_divider" android:layout_width="1dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:background="@color/v4_outline" android:layout_marginTop="13dp" android:layout_marginBottom="13dp" app:layout_constraintStart_toEndOf="@id/title"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/source_latest" style="@style/Widget.Material3Expressive.Button.TextButton" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:letterSpacing="0.0" android:minWidth="50dp" android:text="@string/latest" android:textAllCaps="false" app:layout_constraintEnd_toStartOf="@id/source_pin" android:textColor="@color/v4_primary" app:iconTint="@color/v4_primary"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/source_pin" style="?materialIconButtonStyle" app:iconTint="@color/v4_primary" android:layout_width="42dp" android:layout_height="0dp" android:layout_marginEnd="0dp" app:icon="@drawable/ic_pin_24dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" android:contentDescription="@string/pin"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
