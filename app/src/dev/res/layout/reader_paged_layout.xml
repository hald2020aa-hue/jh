<?xml version='1.0' encoding='UTF-8'?>
<eu.kanade.tachiyomi.ui.reader.settings.ReaderPagedView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/filter_bottom_sheet" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/v4_neon_nav" android:clipToPadding="false" android:paddingBottom="12dp">

    <LinearLayout android:id="@+id/filter_linear_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/material_component_dialogs_padding_around_content_area" android:orientation="vertical" android:paddingTop="0dp" android:paddingEnd="@dimen/material_component_dialogs_padding_around_content_area">

        <eu.kanade.tachiyomi.widget.MaterialSpinnerView android:id="@+id/pager_nav" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" app:title="@string/tap_zones" android:entries="@array/reader_nav" android:background="@drawable/v4_neon_surface" android:paddingStart="10dp" android:paddingEnd="10dp" android:minimumHeight="54dp"/>

        <eu.kanade.tachiyomi.widget.MaterialSpinnerView android:id="@+id/pager_invert" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" app:title="@string/invert_tapping" android:entries="@array/invert_tapping_mode" android:background="@drawable/v4_neon_surface" android:paddingStart="10dp" android:paddingEnd="10dp" android:minimumHeight="54dp"/>

        <eu.kanade.tachiyomi.widget.MaterialSpinnerView android:id="@+id/scale_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" app:title="@string/scale_type" android:entries="@array/image_scale_type" android:background="@drawable/v4_neon_surface" android:paddingStart="10dp" android:paddingEnd="10dp" android:minimumHeight="54dp"/>

        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/landscape_zoom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/zoom_double_page_spreads" android:textColor="@color/v4_text" android:background="@drawable/v4_neon_surface" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="13dp" android:paddingBottom="13dp"/>

        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/navigate_pan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/navigate_pan" android:textColor="@color/v4_text" android:background="@drawable/v4_neon_surface" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="13dp" android:paddingBottom="13dp"/>

        <eu.kanade.tachiyomi.widget.MaterialSpinnerView android:id="@+id/page_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" app:title="@string/page_layout" android:entries="@array/page_layouts" android:background="@drawable/v4_neon_surface" android:paddingStart="10dp" android:paddingEnd="10dp" android:minimumHeight="54dp"/>

        <eu.kanade.tachiyomi.widget.MaterialSpinnerView android:id="@+id/extend_past_cutout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" app:title="@string/cutout_area_behavior" android:entries="@array/cutout_behavior" android:background="@drawable/v4_neon_surface" android:paddingStart="10dp" android:paddingEnd="10dp" android:minimumHeight="54dp"/>

        <eu.kanade.tachiyomi.widget.MaterialSpinnerView android:id="@+id/extend_past_cutout_landscape" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" app:title="@string/cutout_area_behavior" android:entries="@array/cutout_behavior_landscape" android:background="@drawable/v4_neon_surface" android:paddingStart="10dp" android:paddingEnd="10dp" android:minimumHeight="54dp"/>

        <eu.kanade.tachiyomi.widget.MaterialSpinnerView android:id="@+id/zoom_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" app:title="@string/zoom_start_position" android:entries="@array/zoom_start" android:background="@drawable/v4_neon_surface" android:paddingStart="10dp" android:paddingEnd="10dp" android:minimumHeight="54dp"/>

        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/invert_double_pages" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/invert_double_pages" android:textColor="@color/v4_text" android:background="@drawable/v4_neon_surface" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="13dp" android:paddingBottom="13dp"/>

        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/crop_borders" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/crop_borders" android:textColor="@color/v4_text" android:background="@drawable/v4_neon_surface" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="13dp" android:paddingBottom="13dp"/>

        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/page_transitions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/animate_page_transitions" android:textColor="@color/v4_text" android:background="@drawable/v4_neon_surface" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="13dp" android:paddingBottom="13dp"/>

        <!-- Webtoon Prefs -->
        <eu.kanade.tachiyomi.widget.MaterialSpinnerView android:id="@+id/webtoon_nav" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:entries="@array/reader_nav" app:title="@string/tap_zones" android:background="@drawable/v4_neon_surface" android:paddingStart="10dp" android:paddingEnd="10dp" android:minimumHeight="54dp"/>

        <eu.kanade.tachiyomi.widget.MaterialSpinnerView android:id="@+id/webtoon_invert" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" app:title="@string/invert_tapping" android:entries="@array/invert_tapping_mode" android:background="@drawable/v4_neon_surface" android:paddingStart="10dp" android:paddingEnd="10dp" android:minimumHeight="54dp"/>

        <LinearLayout android:id="@+id/webtoon_side_padding_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/reader_settings_spacing" android:gravity="center_vertical" android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView android:id="@+id/webtoon_side_padding" style="?textAppearanceBodyMedium" android:textSize="15sp" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="@string/pref_webtoon_side_padding"/>

            <com.google.android.material.slider.Slider android:id="@+id/webtoon_side_padding_slider" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:valueFrom="0" android:valueTo="25" android:stepSize="5" tools:value="0"/>
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/crop_borders_webtoon" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/crop_borders" android:textColor="@color/v4_text" app:layout_constraintTop_toTopOf="parent" android:background="@drawable/v4_neon_surface" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="13dp" android:paddingBottom="13dp"/>

        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/webtoon_enable_zoom_out" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/enable_zoom_out" android:textColor="@color/v4_text" app:layout_constraintTop_toBottomOf="@id/webtoon_side_padding" android:background="@drawable/v4_neon_surface" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="13dp" android:paddingBottom="13dp"/>

        <eu.kanade.tachiyomi.widget.MaterialSpinnerView android:id="@+id/webtoon_page_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" app:title="@string/page_layout" android:entries="@array/webtoon_page_layouts" android:background="@drawable/v4_neon_surface" android:paddingStart="10dp" android:paddingEnd="10dp" android:minimumHeight="54dp"/>

        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/webtoon_invert_double_pages" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/invert_double_pages" android:textColor="@color/v4_text" android:background="@drawable/v4_neon_surface" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="13dp" android:paddingBottom="13dp"/>

        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/webtoon_page_transitions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/animate_page_transitions" android:textColor="@color/v4_text" android:background="@drawable/v4_neon_surface" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="13dp" android:paddingBottom="13dp"/>
    </LinearLayout>
</eu.kanade.tachiyomi.ui.reader.settings.ReaderPagedView>
