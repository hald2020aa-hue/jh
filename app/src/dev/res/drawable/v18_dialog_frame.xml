<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle">
        <gradient android:angle="0" android:startColor="@color/v18_cyan_edge"
            android:centerColor="@color/v18_blue_edge" android:endColor="@color/v18_pink_edge" />
        <corners android:radius="25dp" />
    </shape></item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/v18_surface" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
